rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects - public read, controlled write
    match /projects/{projectId} {
      // Public read access for project listings and details
      allow read: if isProjectPublic(projectId) || isProjectOwner(projectId) || isAdminUser();
      
      // Only project owners can update their projects
      allow update: if isProjectOwner(projectId) || isAdminUser();
      
      // Only admins can create/delete projects
      allow create, delete: if isAdminUser();
    }

    // User profiles are readable by the user themselves
    match /users/{userId} {
      // Allow users to read and update their own profiles
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pending permissions collection
    match /pendingPermissions/{permissionId} {
      // Only admins can write, authenticated users can read
      allow read: if isAuthenticated();
      allow write: if isAdminUser();
    }

    // Testing Campaigns - project owners create, testers discover open ones
    match /TestingCampaigns/{campaignId} {
      // Public read for open campaigns, owners and admins can read all
      allow read: if resource.data.status == 'open' || 
                     isProjectOwner(resource.data.projectId) || 
                     isAdminUser();
      
      // Only project owners and admins can create/update/delete
      allow create, update, delete: if isProjectOwner(resource.data.projectId) || isAdminUser();
    }

    // Campaign Submissions - testers submit, project owners + admins review
    match /CampaignSubmissions/{submissionId} {
      // Testers can read their own submissions, campaign owners + admins can read all
      allow read: if request.auth.uid == resource.data.testerId || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      
      // Testers can create submissions for open campaigns
      allow create: if request.auth.uid == request.resource.data.testerId && 
                       isAuthenticated() &&
                       get(/databases/$(database)/documents/TestingCampaigns/$(request.resource.data.campaignId)).data.status == 'open';
      
      // Testers can update their own submissions, owners/admins can update to approve/reject
      allow update: if (request.auth.uid == resource.data.testerId && resource.data.status == 'draft') || 
                       isCampaignOwner(resource.data.campaignId) || 
                       isAdminUser();
      
      // Only campaign owners and admins can delete
      allow delete: if isCampaignOwner(resource.data.campaignId) || isAdminUser();
    }

    // Token Allocations - dev allocates equity to testers after campaign
    match /TokenAllocations/{allocationId} {
      // Testers can read their own allocations, campaign owners + admins can read all
      allow read: if request.auth.uid == resource.data.testerId || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      
      // Campaign owners + admins can create allocations
      allow create: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      
      // Testers can accept/reject, owners can update status
      allow update: if (request.auth.uid == resource.data.testerId && 
                       request.resource.data.status in ['accepted', 'rejected']) ||
                      isCampaignOwner(resource.data.campaignId) || 
                      isAdminUser();
      
      // Only admins can delete
      allow delete: if isAdminUser();
    }

    // Payouts - USDC transfers to testers
    match /Payouts/{payoutId} {
      // Testers can read their own payouts, campaign owners + admins can read all
      allow read: if request.auth.uid == resource.data.testerId || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      
      // Campaign owners + admins can create payouts (triggers Circle API)
      allow create: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      
      // Campaign owners + admins can update status
      allow update: if isCampaignOwner(resource.data.campaignId) || isAdminUser();
      
      // Immutable - no deletes
      allow delete: if false;
    }

    // Payout Logs - audit trail for all transfers
    match /PayoutLogs/{logId} {
      // Admins only
      allow read: if isAdminUser();
      allow create, update, delete: if isAdminUser();
    }

    // Helper functions for access control
    function isProjectOwner(projectId) {
      let userId = request.auth.uid;
      return request.auth != null &&
             exists(/databases/$(database)/documents/projects/$(projectId)) &&
             get(/databases/$(database)/documents/projects/$(projectId)).data.owners.hasAny([userId]);
    }

    function isCampaignOwner(campaignId) {
      let campaign = get(/databases/$(database)/documents/TestingCampaigns/$(campaignId)).data;
      return request.auth != null && isProjectOwner(campaign.projectId);
    }
    
    function isProjectPublic(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
             'isPublic' in get(/databases/$(database)/documents/projects/$(projectId)).data &&
             get(/databases/$(database)/documents/projects/$(projectId)).data.isPublic == true;
    }
    
    function isAdminUser() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
  }
}
