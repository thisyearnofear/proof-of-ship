# Blockchain Configuration
PRIVATE_KEY=your_private_key_for_deployment
INFURA_API_KEY=your_infura_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
REPORT_GAS=true

# RPC URLs for Testnet Deployment
ETHEREUM_SEPOLIA_RPC=https://sepolia.infura.io/v3/your_infura_key
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io
CELO_ALFAJORES_RPC=https://alfajores-forno.celo-testnet.org
LINEA_SEPOLIA_RPC=https://rpc.sepolia.linea.build

# Frontend Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Contract Addresses (will be filled after deployment)
NEXT_PUBLIC_BUILDER_CREDIT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_BUILDER_CREDIT_ADDRESS_ARBITRUM_SEPOLIA=
NEXT_PUBLIC_BUILDER_CREDIT_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_BUILDER_CREDIT_ADDRESS_OP_SEPOLIA=
NEXT_PUBLIC_BUILDER_CREDIT_ADDRESS_CELO_ALFAJORES=
NEXT_PUBLIC_BUILDER_CREDIT_ADDRESS_LINEA_SEPOLIA=

# Circle API (REQUIRED for hackathon)
CIRCLE_API_KEY=your_circle_sandbox_api_key
CIRCLE_WALLET_SET_ID=your_wallet_set_id
CIRCLE_ENTITY_SECRET=your_entity_secret
CIRCLE_ENVIRONMENT=sandbox

# LI.FI API (REQUIRED for hackathon)
NEXT_PUBLIC_LIFI_API_KEY=your_lifi_api_key

# GitHub API (for real credit scoring)
GITHUB_TOKEN=your_github_personal_access_token

# MetaMask SDK (for bonus points)
NEXT_PUBLIC_METAMASK_PROJECT_ID=your_metamask_project_id

# AIsa x402 Nanopayments (agent-to-agent payments on Arc Testnet)
# Generate mnemonic: node -e "import('viem/accounts').then(m=>console.log(m.generateMnemonic(require('viem/accounts').english)))"
# Fund with testnet USDC: https://faucet.circle.com (select Arc Testnet)
OWS_MNEMONIC=your twelve word mnemonic phrase here

# Circle Gateway wallet — receives inbound 402 payments from callers of /api/agent/*
# Create via Circle Developer Console: https://developers.circle.com
CIRCLE_GATEWAY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Circle platform wallet for outbound developer funding payouts
# Obtain the wallet ID from your Circle Developer Console
CIRCLE_PLATFORM_WALLET_ID=your_circle_platform_wallet_id

# On-chain agent executor key — signs backProject() calls on Arc Testnet
# Use a dedicated funded key, never share with OWS_MNEMONIC
AGENT_PRIVATE_KEY=your_agent_executor_private_key

# BuilderCreditCore contract deployed on Arc Testnet (chain ID 5042002)
# Run: cd blockchain && npx hardhat run scripts/deployTestnet.js --network arcTestnet
# Then paste the output BUILDER_CREDIT_ARC_ADDRESS value here
# Note: server-only (no NEXT_PUBLIC_) — only used by /api/agent/execute
BUILDER_CREDIT_ARC_ADDRESS=0x0000000000000000000000000000000000000000

# Enable demo mode (no real payments required, uses mock transactions)
# Set to "false" for hackathon live demo
NEXT_PUBLIC_DEMO_MODE=true

# Featherless AI — primary LLM for /api/agent/chat (DeepSeek-V3-0324)
# Get a key at: https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_api_key
