rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for access control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isProjectOwner(col, projectId) {
      let userId = request.auth.uid;
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/$(col)/$(projectId)) &&
             get(/databases/$(database)/documents/$(col)/$(projectId)).data.owners.hasAny([userId]);
    }

    function isProjectPublic(col, projectId) {
      return exists(/databases/$(database)/documents/$(col)/$(projectId)) &&
             'isPublic' in get(/databases/$(database)/documents/$(col)/$(projectId)).data &&
             get(/databases/$(database)/documents/$(col)/$(projectId)).data.isPublic == true;
    }
    
    function isProjectApproved(col, projectId) {
      return exists(/databases/$(database)/documents/$(col)/$(projectId)) &&
             'status' in get(/databases/$(database)/documents/$(col)/$(projectId)).data &&
             get(/databases/$(database)/documents/$(col)/$(projectId)).data.status == 'approved';
    }

    function isCampaignOwner(campaignId) {
      let campaign = get(/databases/$(database)/documents/TestingCampaigns/$(campaignId)).data;
      return isAuthenticated() && isProjectOwner('projects', campaign.projectId);
    }

    // Projects — single collection with ecosystem field
    // Public read for hackathon demo; owner/admin write
    match /projects/{projectId} {
      allow read: if true;
      allow update: if isProjectOwner('projects', projectId) || isAdminUser();
      allow create: if isAuthenticated() && request.resource.data.owners.hasAny([request.auth.uid]) && request.resource.data.submittedBy == request.auth.uid;
      allow delete: if isAdminUser();
    }

    // User profiles — public read for portfolio pages, self-write only
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Drafts — per-user project drafts for auto-save persistence
    match /drafts/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Admin queue - authenticated users can add entries for their submissions
    match /admin_queue/{queueId} {
      allow read: if isAdminUser();
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdminUser();
    }

    // GitHub cache - public read (populated by sync script)
    match /github_cache/{cacheId} {
      allow read: if true;
      allow write: if false; // Only written by admin scripts
    }

    // Pending permissions collection
    match /pendingPermissions/{permissionId} {
      allow read: if isAuthenticated();
      allow write: if isAdminUser();
    }

    // Testing Campaigns
    match /TestingCampaigns/{campaignId} {
      allow read: if resource.data.status == 'open' || 
                     isProjectOwner('projects', resource.data.projectId) || 
                     isAdminUser();
      allow create, update, delete: if isProjectOwner('projects', resource.data.projectId) || isAdminUser();
    }

    // Campaign Submissions
    match /CampaignSubmissions/{submissionId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.testerId) || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.testerId && 
                       get(/databases/$(database)/documents/TestingCampaigns/$(request.resource.data.campaignId)).data.status == 'open';
      allow update: if (isAuthenticated() && request.auth.uid == resource.data.testerId && resource.data.status == 'draft') || 
                       isCampaignOwner(resource.data.campaignId) || 
                       isAdminUser();
      allow delete: if isCampaignOwner(resource.data.campaignId) || isAdminUser();
    }

    // Token Allocations
    match /TokenAllocations/{allocationId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.testerId) || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      allow create: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      allow update: if (isAuthenticated() && request.auth.uid == resource.data.testerId && 
                       request.resource.data.status in ['accepted', 'rejected']) ||
                      isCampaignOwner(request.resource.data.campaignId) || 
                      isAdminUser();
      allow delete: if isAdminUser();
    }

    // Payouts
    match /Payouts/{payoutId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.testerId) || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      allow create: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      allow update: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      allow delete: if false;
    }

    // Payout Logs
    match /PayoutLogs/{logId} {
      allow read: if isAdminUser();
      allow create, update, delete: if isAdminUser();
    }
    
    // Ships Logs
    match /ships_logs/{logId} {
      allow read: if true;
      allow write: if false; // Only written via API
    }
    
    // Activities
    match /activities/{activityId} {
      allow read: if true;
      allow write: if false; // Only written via API
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
    }

    // Wallet index — maps wallet addresses to Firebase UIDs.
    // Used by signInWithWallet to look up existing accounts.
    // Read: any authenticated user can look up their own wallet.
    // Write: only server-side scripts via admin SDK (rules bypassed).
    // The firebase-admin SDK bypasses security rules, so `write: if false`
    // still allows your API routes to write while blocking malicious clients.
    match /wallet_index/{walletAddress} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Agent cache — cached AI agent analysis results.
    // Read: anyone can view cached results.
    // Write: only server-side scripts via admin SDK (rules bypassed).
    // The firebase-admin SDK bypasses security rules, so `write: if false`
    // still allows your API routes to write while blocking malicious clients.
    match /agentCache/{cacheId} {
      allow read: if true;
      allow write: if false;
    }

    // Agent runs — execution logs for agent operations (scout, execute, etc.).
    // Read: admin-only for operational visibility.
    // Write: only server-side scripts via admin SDK (rules bypassed).
    match /agent_runs/{runId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Payout attestations — verification results from the PayoutVerifier agent.
    // Read: publicly visible so anyone can verify a payout claim.
    // Write: only server-side via admin SDK (rules bypassed).
    match /payoutAttestations/{attestationId} {
      allow read: if true;
      allow write: if false;
    }

    // Builder credentials — per-builder aggregate of hackathon win attestations.
    // Each doc: { builderId, totalPrizesWon, totalPrizesVerified, hackathonWins[], lastPayoutAt, payoutReliability }
    // Read: any authenticated user can view credentials.
    // Write: only server-side via admin SDK (rules bypassed).
    match /builderCredentials/{builderId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
